# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=scan_pay_go_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scan_pay_go_db

# Security & JWT Tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_98765
EXIT_QR_SECRET=your_exit_qr_hmac_secret_key_45678

# Razorpay Integration (Test Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000
